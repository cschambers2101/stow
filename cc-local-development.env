# The skill's settings for this repository. Detected by adopt-repo.sh, then set with Craig (13 Nov 2026).
# The languages this repository is written in (csharp, bash, python). Code goes only in these (PRD 0002).
LANGUAGES=bash
LANGUAGE_EXEMPT=".local/bin/ytmusic-tag: a personal YouTube Music tagging helper, kept as it is; _archive/*: retired qtile and Debian material, not stowed or linted"
# The installer predates the standard: about 800 ShellCheck style findings, 34 files shfmt would reformat, and no
# tests for most of lib/. New and changed code gets bats tests first; files are brought up to the standard one at a
# time (docs/tech-debt.md). Until then the pack waits, and VERIFY_EXTRA runs lint.sh and the bats tests.
PACKS_DEFERRED="bash: the existing installer predates the standard and is brought up to it file by file (docs/tech-debt.md), and lint.sh and the bats tests run through VERIFY_EXTRA meanwhile"
VERIFY_EXTRA="bash install_programs/lint.sh && test/bats/bin/bats -r test/unit"
BASH_LIB=install_programs/lib
BASH_TESTS=test
BASE_BRANCH=beta
# Every check and release step runs on this machine. lint.yml stays on GitHub: the repository is public, so it is free.
CI_MODE=local
# Where release.sh reads the version (a Python regex whose first group is X.Y.Z).
VERSION_FILE=VERSION
VERSION_PATTERN='^([0-9]+\.[0-9]+\.[0-9]+)$'
# Copies beta into the stow-dev LXD container on ubuntu-craig-office after every merge.
DEV_DEPLOY='bash deploy/dev-deploy.sh origin/beta stow-dev'
