#!/usr/bin/env bash
# ytmusic: build a music library from YouTube. Song vs playlist detection, tagging via ytmusic-tag. See --help.

set -uo pipefail

FORMAT="best"
KIND="auto"
MUSIC_DIR="${YTMUSIC_DIR:-$HOME/Music}"
ARCHIVE=""
MAXDUR="${YTMUSIC_MAXDUR:-900}"

usage() {
    cat <<'USAGE'
ytmusic — build a music library from YouTube. Detects song vs playlist.

  ytmusic <url|"song name"> [more ...]
  ytmusic --from-file <list.txt>

Options:
  --from-file F  read one url or song name per line ( # comments, blanks ok )
  --best         keep the original audio, no re-encode  (default)
  --mp3          force mp3   (re-encodes; for car stereos and the like)
  --aac          force aac   (re-encodes)
  --song         treat every input as a single track
  --playlist     treat every input as a playlist
  --dir <path>   destination (default ~/Music, or $YTMUSIC_DIR)
  --max-dur <s>  reject anything longer (default 900s) — catches compilations
  -n, --dry-run  show what each input resolves to, download nothing
  --no-lookup    skip the MusicBrainz album/cover-art pass afterwards
  -h, --help     this

A "watch?v=...&list=..." url downloads ONE song, not the whole list.

Layout:
  song      ~/Music/<artist>/<title>.<ext>
  playlist  ~/Music/<artist>/<album>/<NN>-<title>.<ext>

Re-running is cheap: finished tracks are recorded in ~/Music/.ytmusic-archive
and skipped, so a growing playlist or an edited list fetches only what is new.

SEARCHES ARE A GUESS. "first YouTube result" is usually right and sometimes a
cover, a live take or a lyric video. Use --dry-run on a long list first, and
prefer "Artist - Title" over a bare title.
USAGE
}

yt_kind() {
    local url="${1%%#*}" query="" vid="" list="" kv oldifs

    case "$url" in
        ytsearch*:*)      echo search; return ;;
        http://*|https://*) ;;
        *)                echo search; return ;;
    esac

    case "$url" in
        *\?*) query="${url#*\?}" ;;
    esac

    oldifs="$IFS"
    IFS='&'
    for kv in $query; do
        case "$kv" in
            v=*)    vid="${kv#v=}" ;;
            list=*) list="${kv#list=}" ;;
        esac
    done
    IFS="$oldifs"

    if [ -z "$vid" ]; then
        case "$url" in
            *youtu.be/*) vid="${url##*youtu.be/}"; vid="${vid%%\?*}" ;;
            */shorts/*)  vid="${url##*/shorts/}";  vid="${vid%%\?*}" ;;
        esac
    fi

    [ -n "$vid" ] && { echo song; return; }

    if [ -n "$list" ]; then
        case "$list" in
            RD*) echo radio ;;
            *)   echo playlist ;;
        esac
        return
    fi

    echo unknown
}

probe_kind() {
    local t
    t="$(yt-dlp --flat-playlist --no-warnings --playlist-items 1 \
         --print "%(_type)s" "$1" 2>/dev/null | head -1)"
    case "$t" in
        playlist|multi_video) echo playlist ;;
        *)                    echo song ;;
    esac
}

to_target() {
    case "$1" in
        http://*|https://*|ytsearch*:*) printf '%s' "$1" ;;
        *)                              printf 'ytsearch1:%s' "$1" ;;
    esac
}

TARGETS=()
POS=()
DRYRUN=0
LOOKUP=1

while [ "$#" -gt 0 ]; do
    case "$1" in
        --best)     FORMAT="best" ;;
        --mp3)      FORMAT="mp3" ;;
        --aac)      FORMAT="aac" ;;
        --song|--single|--no-playlist) KIND="song" ;;
        --playlist|--yes-playlist)     KIND="playlist" ;;
        --dir)      shift; MUSIC_DIR="${1:?--dir needs a path}" ;;
        --max-dur)  shift; MAXDUR="${1:?--max-dur needs seconds}" ;;
        -n|--dry-run) DRYRUN=1 ;;
        --no-lookup)  LOOKUP=0 ;;
        -h|--help)  usage; exit 0 ;;
        --from-file)
            shift
            LIST="${1:?--from-file needs a path}"
            [ -r "$LIST" ] || { echo "ytmusic: cannot read '$LIST'" >&2; exit 1; }
            while IFS= read -r line || [ -n "$line" ]; do
                line="${line%$'\r'}"
                line="${line#"${line%%[![:space:]]*}"}"
                line="${line%"${line##*[![:space:]]}"}"
                case "$line" in
                    ''|'#'*) continue ;;
                esac
                TARGETS+=("$line")
            done < "$LIST"
            ;;
        -*)         echo "ytmusic: unknown option '$1'" >&2; usage >&2; exit 2 ;;
        *)          POS+=("$1") ;;
    esac
    shift
done

WORDS=()
for p in ${POS+"${POS[@]}"}; do
    if [ -f "$p" ] && [ -r "$p" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            line="${line%$'\r'}"
            line="${line#"${line%%[![:space:]]*}"}"
            line="${line%"${line##*[![:space:]]}"}"
            case "$line" in ''|'#'*) continue ;; esac
            TARGETS+=("$line")
        done < "$p"
        echo "ytmusic: reading list from $p" >&2
    else
        case "$p" in
            http://*|https://*|ytsearch*:*) TARGETS+=("$p") ;;
            *)                              WORDS+=("$p") ;;
        esac
    fi
done

if [ "${#WORDS[@]}" -gt 0 ]; then
    joined=1
    for w in "${WORDS[@]}"; do
        case "$w" in *[[:space:]]*) joined=0; break ;; esac
    done
    if [ "$joined" -eq 1 ]; then
        TARGETS+=("${WORDS[*]}")
    else
        TARGETS+=("${WORDS[@]}")
    fi
fi

[ "${#TARGETS[@]}" -eq 0 ] && { usage >&2; exit 2; }
ARCHIVE="$MUSIC_DIR/.ytmusic-archive"

command -v yt-dlp >/dev/null || { echo "ytmusic: yt-dlp is not installed." >&2; exit 1; }
command -v ffmpeg >/dev/null || { echo "ytmusic: ffmpeg is not installed — extraction and tagging need it." >&2; exit 1; }

if ! command -v AtomicParsley >/dev/null 2>&1; then
    case "$FORMAT" in
        aac|best) echo "ytmusic: note — AtomicParsley is missing, so cover art may not embed into m4a/aac. Install: sudo apt install atomicparsley" >&2 ;;
    esac
fi

mkdir -p "$MUSIC_DIR" || exit 1

total="${#TARGETS[@]}"
i=0
rc=0
failed=()

for raw in "${TARGETS[@]}"; do
    i=$((i + 1))
    target="$(to_target "$raw")"

    kind="$KIND"
    if [ "$kind" = "auto" ]; then
        kind="$(yt_kind "$target")"
        [ "$kind" = "unknown" ] && kind="$(probe_kind "$target")"
    fi

    if [ "$kind" = "radio" ]; then
        echo "[$i/$total] SKIP  mix/radio, never ends: $raw" >&2
        echo "              use the track's own url, or force with --playlist" >&2
        failed+=("$raw")
        rc=1
        continue
    fi

    if [ "$DRYRUN" -eq 1 ]; then
        printf '[%d/%d] %-8s %s\n' "$i" "$total" "$kind" "$raw"
        [ "$kind" = "search" ] && printf '           -> %s\n' "$target"
        continue
    fi

    opts=(
        -x --audio-format "$FORMAT"
        --restrict-filenames
        --embed-metadata
        --embed-thumbnail
        --ppa "ThumbnailsConvertor+ffmpeg_o:-vf crop=ih:ih"
        --download-archive "$ARCHIVE"
        --paths "$MUSIC_DIR"
        --no-warnings
        --sleep-interval 1 --max-sleep-interval 3
        --parse-metadata "title:(?P<artist>.+?)\s+[-–—]\s+(?P<title>.+)"
        --replace-in-metadata "title,artist" "(?i)\s*[\(\[](?:official|lyric|lyrics|audio|video|hd|hq|4k|remaster(?:ed)?|music video)[^\)\]]*[\)\]]" ""
        --parse-metadata "%(artist,uploader)s:%(meta_artist)s"
        --parse-metadata ":(?P<meta_description>)"
        --parse-metadata ":(?P<meta_synopsis>)"
        --parse-metadata ":(?P<meta_comment>)"
    )

    [ "$FORMAT" != "best" ] && opts+=(--audio-quality 0)

    if [ "$kind" = "playlist" ]; then
        opts+=(
            --yes-playlist
            --ignore-errors
            --parse-metadata "%(playlist_title,playlist)s:%(meta_album)s"
            -o "%(playlist_uploader,artist,uploader)s/%(playlist_title,playlist)s/%(playlist_index)02d-%(title)s.%(ext)s"
        )
        echo "[$i/$total] playlist: $raw"
    else
        opts+=(
            --no-playlist
            -o "%(artist,uploader)s/%(title)s.%(ext)s"
        )
        [ "$kind" = "search" ] && opts+=(--match-filter "duration < $MAXDUR")
        echo "[$i/$total] $kind: $raw"
    fi

    if ! yt-dlp "${opts[@]}" "$target"; then
        rc=$?
        failed+=("$raw")
        echo "[$i/$total] FAILED: $raw" >&2
    fi
done

echo ""
if [ "$DRYRUN" -eq 1 ]; then
    echo "ytmusic: dry run finished — $total checked, nothing downloaded."
else
    echo "ytmusic: finished — $((total - ${#failed[@]})) of $total ok."
fi

if [ "$LOOKUP" -eq 1 ] && [ "$DRYRUN" -eq 0 ] && command -v ytmusic-tag >/dev/null 2>&1; then
    echo ""
    echo "Looking up albums and cover art..."
    ytmusic-tag "$MUSIC_DIR" || true
fi

if [ "${#failed[@]}" -gt 0 ]; then
    echo "" >&2
    echo "ytmusic: ${#failed[@]} of $total did not download:" >&2
    printf '  %s\n' "${failed[@]}" >&2
    echo "Re-run the same command to retry only these — the rest are in the archive." >&2
fi

exit "$rc"
