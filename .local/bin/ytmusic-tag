#!/usr/bin/env python3
"""
ytmusic-tag — fill in album, year and real cover art from MusicBrainz.

WHY THIS EXISTS

YouTube supplies no album metadata at all. Checked directly: `album`, `track`
and `release_year` come back NA for AC/DC's Thunderstruck on both youtube.com
and music.youtube.com, and a search returns no "- Topic" art-track upload that
would have carried it. So every download shows as "Unknown album" in a player,
and the embedded art is a 16:9 video still with a vevo logo in the corner
rather than a cover.

MusicBrainz and the Cover Art Archive fix both, are free and open, and need no
API key.

THE PART THAT NEEDS CARE

A naive "first result" lookup is confidently WRONG. Measured:

  iTunes       Thunderstruck -> "Iron Man 2"          (a film soundtrack)
  MusicBrainz  Thunderstruck -> "No Bull: Live"       (a live album)
               Bohemian Rhapsody -> "Zoom 1979"       (a bootleg)

The searches are dominated by bootlegs, live records and compilations, and
tagging a library with those is worse than leaving it blank: wrong data looks
authoritative and nobody re-checks it. Two filters fix it, and both are needed:

  1. The recording's artist credit must actually match. Without this a
     same-titled song by someone else scores 100 and wins.
  2. The release group must be primary-type Album with NO secondary types,
     which is what excludes Live, Compilation, Soundtrack and Remix.

Then take the EARLIEST such release, which is the original album rather than a
reissue. With both filters: The Razors Edge (1990), A Night At The Opera
(1975), Appetite for Destruction. Verified.

MusicBrainz returns 503 under load fairly often -- it did repeatedly while this
was being written -- so every request retries with backoff, and the whole thing
fails soft. A lookup that cannot complete must never cost you the download you
already have.
"""

import base64
import json
import re
import struct
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

UA = "ytmusic-tag/1.0 ( https://github.com/cschambers2101/stow )"
MB = "https://musicbrainz.org/ws/2"
CAA = "https://coverartarchive.org"
RATE = 1.1          # MusicBrainz asks for no more than 1 request/second
BACKOFF = (5, 15, 30, 60)
_last_call = [0.0]

def http(url, timeout=25, tries=5, binary=False):
    """GET with backoff. MusicBrainz 503s under load; that is not an error."""
    for attempt in range(tries):
        wait = RATE - (time.time() - _last_call[0])
        if wait > 0:
            time.sleep(wait)
        _last_call[0] = time.time()
        try:
            req = urllib.request.Request(url, headers={"User-Agent": UA})
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return r.read() if binary else json.load(r)
        except urllib.error.HTTPError as e:
            if e.code == 404:
                return None
            if attempt == tries - 1:
                raise
            time.sleep(BACKOFF[min(attempt, len(BACKOFF) - 1)])
        except Exception:
            if attempt == tries - 1:
                raise
            time.sleep(BACKOFF[min(attempt, len(BACKOFF) - 1)])
    return None

def norm(s):
    return re.sub(r"[^a-z0-9]", "", (s or "").lower())

_NOISE_WORDS = (r"official|lyrics?|audio|video|hd|hq|4k|remaster(?:ed)?|"
                r"single|album|full|extended|version|edit|clip|promo|"
                r"visuali[sz]er|mv|live|tour|concert|session|toppop|"
                r"top\s*of\s*the\s*pops|bbc|from")
_NOISE_BRACKET = re.compile(r"(?i)\s*[\(\[][^\)\]]*\b(?:" + _NOISE_WORDS + r")\b[^\)\]]*[\)\]]")
_NOISE_TAIL = re.compile(r"(?i)\s+[-–—]\s+[^-–—]*\b(?:" + _NOISE_WORDS + r")\b.*$")
_NOISE_BARE = re.compile(r"(?i)\s+\b(?:hd|hq|4k)\b\s*$")

_NOISE_YEAR = re.compile(r"\s*[\(\[][^\)\]]*\b(?:19|20)\d{2}\b[^\)\]]*[\)\]]")
_NOISE_BULLET = re.compile(r"\s*[•|·]\s*.*$")
_QUOTED = re.compile(r'^\s*["\u201c\u2018\'](.+?)["\u201d\u2019\']\s*$')

def strip_artist_prefix(title, artist):
    """Drop a leading "Metallica: " from "Metallica: Enter Sandman"."""
    m = re.match(r"^(.+?)\s*[:\-–—]\s+(.+)$", title or "")
    if m and norm(m.group(1)) == norm(artist) and m.group(2).strip():
        return m.group(2).strip()
    return title

_JUNK_SYM = re.compile(
    "[\U0001F000-\U0001FAFF\u2190-\u21FF\u2300-\u27BF\u2B00-\u2BFF\uFE0F]")
_LEAD_SHOUT = re.compile(r"(?i)^\s*(?:new|hq|hd|full)\b[\s:\u2013\u2014-]*")
_BRACE = re.compile(r"\s*\{[^}]*\}")

def clean_name(t):
    """Cleanup that applies to an ARTIST field as well as a title. Uploaders
    put junk in whichever half of "X - Y" they choose, and when the halves are
    reversed our artist tag is holding their title."""
    if not t:
        return t
    t = _JUNK_SYM.sub(" ", t)
    t = _BRACE.sub("", t)
    t = _LEAD_SHOUT.sub("", t)
    return re.sub(r"\s{2,}", " ", t).strip()

def clean_title(t):
    """Strip upload noise. Only removes bracketed or trailing junk, so a real
    title is untouched: "Video Killed the Radio Star" and "(I Can't Get No)
    Satisfaction" both survive intact."""
    if not t:
        return t
    t = clean_name(t)
    t = _NOISE_BULLET.sub("", t)
    for rx in (_NOISE_BRACKET, _NOISE_TAIL, _NOISE_BARE, _NOISE_YEAR):
        t = rx.sub("", t)
    t = re.sub(r"\s{2,}", " ", t).strip()
    m = _QUOTED.match(t)          # after stripping, so ("Barracuda" (1977)) works
    if m:
        t = m.group(1).strip()
    return t

def lookup(artist, title):
    """Return (album, year, release_mbid, canonical_artist) for the original."""
    query = f'recording:"{title}" AND artist:"{artist}"'
    url = f"{MB}/recording?" + urllib.parse.urlencode(
        {"query": query, "fmt": "json", "limit": 100})
    data = http(url)
    if not data:
        return None

    want = norm(artist)
    want_title = norm(title)
    found = []
    for rec in data.get("recordings", []):
        if rec.get("score", 0) < 90:
            continue
        raw_credit = "".join((a.get("name") or "") + (a.get("joinphrase") or "")
                             for a in rec.get("artist-credit", []))
        credit = norm(raw_credit)
        if want not in credit and credit not in want:
            continue
        if norm(rec.get("title")) != want_title:
            continue
        for rel in rec.get("releases", []):
            group = rel.get("release-group") or {}
            if group.get("primary-type") != "Album":
                continue
            if group.get("secondary-types"):      # Live / Compilation / Soundtrack
                continue
            if rel.get("status") != "Official":
                continue
            date = group.get("first-release-date") or rel.get("date") or ""
            found.append((date[:4] or "9999", rel.get("title"), rel.get("id"),
                          raw_credit))

    if not found:
        return None
    found.sort()                                  # earliest == the original
    year, album, mbid, credit = found[0]
    return album, (None if year == "9999" else year), mbid, credit

def cover(mbid):
    try:
        return http(f"{CAA}/release/{mbid}/front-500", binary=True, tries=2)
    except Exception:
        return None

def flac_picture(jpeg):
    """Build the FLAC PICTURE block Ogg/Opus wants, as base64."""
    mime = b"image/jpeg"
    out = struct.pack(">I", 3)                    # type 3 = front cover
    out += struct.pack(">I", len(mime)) + mime
    out += struct.pack(">I", 0)                   # empty description
    out += struct.pack(">IIII", 0, 0, 0, 0)
    out += struct.pack(">I", len(jpeg)) + jpeg
    return base64.b64encode(out).decode("ascii")

YT_CATEGORIES = {norm(x) for x in (
    "Music", "People & Blogs", "Entertainment", "Film & Animation", "Gaming",
    "Sports", "News & Politics", "Howto & Style", "Education", "Comedy",
    "Science & Technology", "Autos & Vehicles", "Pets & Animals",
    "Travel & Events", "Nonprofits & Activism", "Short Movies", "Shows",
    "Trailers",
)}

_genre_cache = {}          # (artist, album) -> genre or None
_artist_cache = {}         # artist -> genre or None

def _top_genre(entity):
    """Highest-voted genre from a MusicBrainz entity, title-cased."""
    gs = sorted(entity.get("genres") or [], key=lambda g: -(g.get("count") or 0))
    return gs[0]["name"].title() if gs else None

def genre_for(artist, album):
    """Album genre, falling back to the artist's. Both cached: many tracks
    share an album, and far more share an artist, so the cache does real work
    on a big library rather than being decoration."""
    key = (norm(artist), norm(album))
    if key in _genre_cache:
        return _genre_cache[key]

    genre = None
    if album:
        q = f'releasegroup:"{album}" AND artist:"{artist}"'
        url = f"{MB}/release-group?" + urllib.parse.urlencode(
            {"query": q, "fmt": "json", "limit": 1})
        try:
            data = http(url) or {}
            rgs = data.get("release-groups") or []
            if rgs:
                full = http(f"{MB}/release-group/{rgs[0]['id']}?inc=genres&fmt=json")
                genre = _top_genre(full or {})
        except Exception:
            genre = None

    if not genre:
        ak = norm(artist)
        if ak in _artist_cache:
            genre = _artist_cache[ak]
        else:
            try:
                url = f"{MB}/artist?" + urllib.parse.urlencode(
                    {"query": f'artist:"{artist}"', "fmt": "json", "limit": 1})
                data = http(url) or {}
                arts = data.get("artists") or []
                if arts:
                    full = http(f"{MB}/artist/{arts[0]['id']}?inc=genres&fmt=json")
                    genre = _top_genre(full or {})
            except Exception:
                genre = None
            _artist_cache[ak] = genre

    _genre_cache[key] = genre
    return genre

_NUMWORDS = {"one": "1", "two": "2", "three": "3", "four": "4", "five": "5",
             "six": "6", "seven": "7", "eight": "8", "nine": "9", "ten": "10"}

def _digits(t):
    """"Another Brick In The Wall, Part Two" -> "... Part 2"."""
    return re.sub(r"\b(" + "|".join(_NUMWORDS) + r")\b",
                  lambda m: _NUMWORDS[m.group(1).lower()], t, flags=re.I)

def search_variants(artist, title):
    """Fallbacks to try when the exact pair finds nothing. Each costs a
    request, so they run ONLY after a real failure -- roughly one file in five.

    Every one comes from an observed failure in the first 400 tracks:
      Sweet - The Ballroom Blitz     MusicBrainz files it as "Ballroom Blitz"
      ... Part Two                   MusicBrainz writes "Part 2"
      In The End - Linkin Park       uploader put the title first, so our
                                     artist/title split is exactly backwards

    False positives are not a risk: the caller still demands an exact title
    match AND an artist-credit match, so a wrong guess simply finds nothing.
    """
    seen = {(norm(artist), norm(title))}
    for a, t in ((artist, re.sub(r"^(?:the|a)\s+", "", title, flags=re.I)),
                 (artist, _digits(title)),
                 (clean_title(title), clean_title(artist))):
        key = (norm(a), norm(t))
        if a and t and key not in seen:
            seen.add(key)
            yield a, t

def tag_genre(path, dry=False):
    """Replace a YouTube upload category with a real genre."""
    from mutagen import File as MFile
    f = MFile(path, easy=True)
    if f is None:
        return "skip", f"unreadable {path.name}"
    artist = (f.get("artist") or [""])[0]
    album = (f.get("album") or [""])[0]
    current = (f.get("genre") or [""])[0]

    if current and norm(current) not in YT_CATEGORIES:
        return "skip", f"already has genre {current!r}"
    if not artist:
        return "skip", f"no artist tag on {path.name}"

    genre = genre_for(artist, album)
    if not genre:
        if current and not dry:
            del f["genre"]
            f.save()
        return ("dry" if dry else "blank"), f"{artist}: no genre found, cleared {current!r}"

    if dry:
        return "dry", f"{artist} - {album or '?'} -> {genre!r}"
    f["genre"] = genre
    f.save()
    return "ok", f"{artist} - {album or '?'} -> {genre!r}"

def tag_file(path, dry=False, art=True, artists_only=False):
    from mutagen.oggopus import OggOpus
    from mutagen.mp3 import MP3
    from mutagen.mp4 import MP4, MP4Cover
    from mutagen.id3 import APIC, TALB, TDRC, TPE1, TIT2

    suffix = path.suffix.lower()
    if suffix == ".opus":
        f = OggOpus(path)
        artist = (f.get("artist") or [None])[0]
        title = (f.get("title") or [None])[0]
        existing = (f.get("album") or [None])[0]
    elif suffix == ".mp3":
        f = MP3(path)
        artist = str(f.get("TPE1")) if f.get("TPE1") else None
        title = str(f.get("TIT2")) if f.get("TIT2") else None
        existing = str(f.get("TALB")) if f.get("TALB") else None
    elif suffix in (".m4a", ".aac", ".mp4"):
        f = MP4(path)
        artist = (f.get("\xa9ART") or [None])[0]
        title = (f.get("\xa9nam") or [None])[0]
        existing = (f.get("\xa9alb") or [None])[0]
    else:
        return "skip", f"unsupported format {suffix}"

    if not artist or not title:
        return "skip", "no artist/title tags to search on"
    if existing and not artists_only:
        return "skip", f"already has album {existing!r}"

    search_title = clean_title(strip_artist_prefix(title, artist))
    fixed_title = search_title if search_title != title else None

    use_artist, use_title = artist, search_title
    hit = lookup(artist, search_title)
    if not hit:
        for cand_a, cand_t in search_variants(artist, search_title):
            hit = lookup(cand_a, cand_t)
            if hit:
                use_artist, use_title = cand_a, cand_t
                break
    if not hit:
        return "none", f"{artist} - {search_title}: no original studio album found"

    fixed_title = use_title if use_title != title else None
    swapped_artist = use_artist if use_artist != artist else None
    artist = use_artist
    album, year, mbid, credit = hit

    fixed_artist = swapped_artist
    if credit and credit != artist and norm(credit) == norm(artist):
        fixed_artist = credit

    if artists_only:
        fixed_title = None
        if not fixed_artist:
            return "skip", f"{artist}: name already canonical"
        if dry:
            return "dry", f"{artist!r} -> {fixed_artist!r}  ({path.name})"

    if dry:
        note = f", artist -> {fixed_artist!r}" if fixed_artist else ""
        return "dry", f"{artist} - {title} -> {album!r} ({year or '?'}){note}"

    jpeg = cover(mbid) if (art and not artists_only) else None
    if artists_only:
        album = existing or album

    if suffix == ".opus":
        f["album"] = album
        if fixed_artist:
            f["artist"] = fixed_artist
        if fixed_title:
            f["title"] = fixed_title
        if year:
            f["date"] = year
        if jpeg:
            f["metadata_block_picture"] = [flac_picture(jpeg)]
    elif suffix == ".mp3":
        f.tags.add(TALB(encoding=3, text=album))
        if fixed_artist:
            f.tags.add(TPE1(encoding=3, text=fixed_artist))
        if fixed_title:
            f.tags.add(TIT2(encoding=3, text=fixed_title))
        if year:
            f.tags.add(TDRC(encoding=3, text=year))
        if jpeg:
            f.tags.delall("APIC")
            f.tags.add(APIC(encoding=3, mime="image/jpeg", type=3, desc="", data=jpeg))
    else:
        f["\xa9alb"] = album
        if fixed_artist:
            f["\xa9ART"] = fixed_artist
        if fixed_title:
            f["\xa9nam"] = fixed_title
        if year:
            f["\xa9day"] = year
        if jpeg:
            f["covr"] = [MP4Cover(jpeg, imageformat=MP4Cover.FORMAT_JPEG)]

    f.save()
    if artists_only:
        return "ok", f"{artist!r} -> {fixed_artist!r}  ({path.name})"
    art_note = "with cover art" if jpeg else "no cover art available"
    name_note = f", artist -> {fixed_artist!r}" if fixed_artist else ""
    title_note = f", title -> {fixed_title!r}" if fixed_title else ""
    return "ok", (f"{artist} - {search_title} -> {album!r} ({year or '?'}), "
                  f"{art_note}{name_note}{title_note}")

def main(argv):
    dry = "-n" in argv or "--dry-run" in argv
    no_art = "--no-art" in argv
    artists_only = "--artists-only" in argv
    genres_mode = "--genres" in argv
    args = [a for a in argv if not a.startswith("-")]
    if not args:
        print(__doc__.strip().splitlines()[0])
        print("\nusage: ytmusic-tag [-n] [--no-art] [--artists-only] "
              "[--genres] <file|directory> ...")
        return 2

    files = []
    for a in args:
        p = Path(a).expanduser()
        if p.is_dir():
            files += sorted(x for x in p.rglob("*")
                            if x.suffix.lower() in (".opus", ".mp3", ".m4a", ".aac"))
        elif p.exists():
            files.append(p)

    if not files:
        print("ytmusic-tag: nothing to do")
        return 0

    counts = {}
    consecutive = 0
    stopped = False
    for p in files:
        try:
            if genres_mode:
                status, msg = tag_genre(p, dry=dry)
            else:
                status, msg = tag_file(p, dry=dry, art=not no_art,
                                       artists_only=artists_only)
        except Exception as e:
            status, msg = "error", f"{p.name}: {type(e).__name__}: {e}"
        counts[status] = counts.get(status, 0) + 1
        print(f"  [{status:5}] {msg}")

        consecutive = consecutive + 1 if status == "error" else 0
        if consecutive >= 5:
            stopped = True
            print("  [halt ] five failures in a row — MusicBrainz is refusing "
                  "requests. Stopping so the rest of the run is not held up.")
            print("  [halt ] re-run 'ytmusic-tag ~/Music' later to fill in the "
                  "gap; anything already tagged is skipped.")
            break

    print("  " + "  ".join(f"{k}={v}" for k, v in sorted(counts.items()))
          + ("  (HALTED EARLY)" if stopped else ""))
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
