#!/usr/bin/env bash
# s6c-booklet - make a saddle-stitched booklet on a Xerox AltaLink C8135
#
# The printer FOLDS AND STAPLES but does NOT impose, so we impose here.
# Portable: no absolute paths, needs only ghostscript + poppler (both pulled in by CUPS).
#
#   s6c-booklet [--a4|--a5] [--print|--out FILE] INPUT.pdf
#
#   --a5  (default) A4 paper folded to A5   -> queue S6C-Booklet-A5, Tray 3
#   --a4            A3 paper folded to A4   -> queue S6C-Booklet-A4, Tray 2
set -euo pipefail

FMT=a5; ACTION=print; OUT=""; IN=""
while [ $# -gt 0 ]; do
  case "$1" in
    --a4) FMT=a4;; --a5) FMT=a5;;
    --print) ACTION=print;;
    --out) ACTION=out; OUT="${2:?--out needs a path}"; shift;;
    -h|--help) sed -n '2,12p' "$0"; exit 0;;
    -*) echo "unknown option: $1" >&2; exit 2;;
    *) IN="$1";;
  esac; shift
done
[ -n "$IN" ] || { echo "usage: $(basename "$0") [--a4|--a5] [--print|--out FILE] INPUT.pdf" >&2; exit 2; }
[ -r "$IN" ] || { echo "cannot read: $IN" >&2; exit 1; }

for t in gs pdfinfo; do command -v "$t" >/dev/null || { echo "missing required tool: $t" >&2; exit 1; }; done

if [ "$FMT" = a4 ]; then
  SHEET_W=842; SHEET_H=1191; QUEUE=S6C-Booklet-A4      # A3 sheet -> A4 pages
else
  SHEET_W=595; SHEET_H=842;  QUEUE=S6C-Booklet-A5      # A4 sheet -> A5 pages
fi

TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT

NPAGES=$(pdfinfo "$IN" | awk '/^Pages:/{print $2}')
[ -n "${NPAGES:-}" ] || { echo "could not read page count from $IN" >&2; exit 1; }

# pad to a multiple of 4 (saddle-stitch needs whole folded sheets)
PAD=$(( (4 - NPAGES % 4) % 4 )); TOTAL=$(( NPAGES + PAD ))
echo "$(basename "$0"): $NPAGES pages + $PAD blank = $TOTAL, $((TOTAL/4)) sheet(s), $FMT booklet" >&2

# one EPS per source page
for n in $(seq 1 "$NPAGES"); do
  gs -q -dNOPAUSE -dBATCH -dSAFER -sDEVICE=eps2write \
     -dFirstPage="$n" -dLastPage="$n" -o "$TMP/pg-$n.eps" "$IN" 2>/dev/null
done

python3 - "$TMP" "$NPAGES" "$TOTAL" "$SHEET_W" "$SHEET_H" > "$TMP/book.ps" <<'PY'
import sys, os
tmp, npages, total, SW, SH = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), float(sys.argv[4]), float(sys.argv[5])
RW, RH = SH, SW              # rotated drawing space
HALF   = RW/2.0              # one booklet page

# saddle-stitch spread order, outermost sheet first
spreads=[]; lo,hi=1,total
for _ in range(total//4):
    spreads.append((hi,lo)); lo+=1; hi-=1     # side A
    spreads.append((lo,hi)); lo+=1; hi-=1     # side B

def bbox(p):
    with open(p,'rb') as f:
        for line in f:
            if line.startswith(b'%%BoundingBox:'):
                v=line.split()[1:5]
                try: return [float(x) for x in v]
                except ValueError: pass
    return None

o=["%!PS-Adobe-3.0", f"%%BoundingBox: 0 0 {SW:.0f} {SH:.0f}", f"%%Pages: {len(spreads)}",
   f"%%DocumentMedia: sheet {SW:.0f} {SH:.0f} 0 () ()", "%%EndComments"]
for i,(lp,rp) in enumerate(spreads,1):
    o += [f"%%Page: {i} {i}", "gsave", f"{SW:.4f} 0 translate 90 rotate"]
    for slot,pg in ((0,lp),(1,rp)):
        eps=os.path.join(tmp, f"pg-{pg}.eps")
        if pg>npages or not os.path.exists(eps):
            continue                                   # padding blank
        bb=bbox(eps)
        if not bb: continue
        w,h = bb[2]-bb[0], bb[3]-bb[1]
        if w<=0 or h<=0: continue
        s = min(HALF/w, RH/h)                          # fit, preserve aspect
        dx = slot*HALF + (HALF - w*s)/2.0
        dy = (RH - h*s)/2.0
        # PostScript save/restore (not gsave) - EPS redefines showpage, and only
        # restore rolls back dictionary changes. gsave would leave showpage a no-op.
        o += ["/epsSave save def",
              "/epsDictCount countdictstack def", "/epsOpCount count 1 sub def",
              f"{dx:.4f} {dy:.4f} translate", f"{s:.6f} {s:.6f} scale",
              f"{-bb[0]:.4f} {-bb[1]:.4f} translate",
              "/showpage {} def /copypage {} def /erasepage {} def",
              f"%%BeginDocument: pg-{pg}.eps"]
        with open(eps, encoding='latin-1') as f:
            o.append(f.read().rstrip("\n"))
        o += ["%%EndDocument",
              "count epsOpCount sub {pop} repeat",
              "countdictstack epsDictCount sub {end} repeat",
              "epsSave restore"]
    o += ["grestore", "showpage"]
o.append("%%EOF")
print("\n".join(o))
PY

gs -q -dNOPAUSE -dBATCH -dSAFER -sDEVICE=pdfwrite \
   -dDEVICEWIDTHPOINTS="$SHEET_W" -dDEVICEHEIGHTPOINTS="$SHEET_H" -dFIXEDMEDIA \
   -dAutoRotatePages=/None -o "$TMP/book.pdf" "$TMP/book.ps"

if [ "$ACTION" = out ]; then
  cp "$TMP/book.pdf" "$OUT"; echo "wrote $OUT" >&2
else
  lp -d "$QUEUE" -t "$(basename "$IN") booklet" "$TMP/book.pdf"
fi
