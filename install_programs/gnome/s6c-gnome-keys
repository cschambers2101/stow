#!/usr/bin/env bash
set -euo pipefail
keys=(
  "Super+Space" "Search and launch apps"
  "Super+Tab / Super+O" "Overview"
  "Super+T" "Terminal"
  "Super+E" "Files"
  "Super+B" "Web browser"
  "Super+Shift+Return" "Terminal file manager (yazi)"
  "Super+Shift+N" "Notepad"
  "Super+Q" "Close window"
  "Super+F" "Maximise"
  "Super+Shift+F" "Fullscreen"
  "Super+Left / Super+H" "Window to left half"
  "Super+Right / Super+L" "Window to right half"
  "Super+Up / Super+K" "Maximise"
  "Super+Down / Super+J" "Restore"
  "Alt+Tab" "Switch windows"
  "Super+1 to 9" "Go to workspace"
  "Super+Shift+1 to 9" "Move window to workspace"
  "Super+Page Down / Super+U" "Next workspace"
  "Super+Page Up / Super+I" "Previous workspace"
  "Super+N" "Notifications"
  "Super+M" "System monitor"
  "Super+Comma" "Settings"
  "Super+Y" "Wallpaper"
  "Super+Escape" "Lock screen"
  "Super+X" "Power off or restart"
  "Super+Shift+E" "Log out"
  "Print" "Screenshot"
  "Ctrl+Print" "Screenshot of the whole screen"
  "Alt+Print" "Screenshot of a window"
  "Super+Alt+Space" "Change keyboard layout"
)
exec zenity --list --title="Keyboard shortcuts" --width=520 --height=720 \
  --column=Keys --column=Does "${keys[@]}"
