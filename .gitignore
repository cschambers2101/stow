**.swp
*.bak
.vim/
**/__pycache__/

# Vendor CLI tools install themselves into ~/.local/bin, which is a stow
# symlink INTO this repo -- so their binaries land inside the working tree.
# On a machine built by the installer, `agy` alone is a 199 MB binary sitting
# in git status. Neither belongs in a dotfiles repo: agy is a vendored blob,
# and claude is a symlink to a version-pinned absolute path
# (~/.local/share/claude/versions/N.N.N) that is wrong on every other machine.
# Both are reinstalled by the setup script, so nothing is lost by ignoring them.
.local/bin/agy
.local/bin/claude

# niri / DankMaterialShell: auto-generated backups, matugen output, machine state
.config/niri/config.kdl.backup*
.config/niri/config.kdl.dmsbackup*
.config/niri/dms/*.bak
.config/niri/dms/colors.kdl
.config/niri/dms/outputs.kdl
# cursor.kdl is DMS-generated too and its own header says so ("DO NOT EDIT /
# AUTO-GENERATED BY DMS / PLACE YOUR CUSTOM CONFIGURATION ELSEWHERE"). Applying
# a DMS theme rewrites it: on ubuntu-craig-office (2 Sep 2026) it was truncated
# to 0 bytes at the same second colors.kdl was regenerated, and showed up as a
# 9-line deletion in git status. Tracking a file DMS owns just guarantees a
# recurring spurious diff. If a fleet-wide cursor theme is wanted it has to go
# somewhere DMS does not overwrite -- not here.
.config/niri/dms/cursor.kdl
# settings.json is DMS's own live state and it owns the file: it rewrites it
# atomically on every save. Two keys guarantee a diff forever -- 1.6 serialises
# desktopClockCustomColor and systemMonitorCustomColor as eleven-field QColor
# objects while their defaults are declared as the string "#ffffff", and a
# string can never compare equal to an object. On top of that the file holds
# machine state that must not travel: lockScreenWallpaperPath is a per-boot
# /run/user path (ab906c0 committed one by accident) and networkPreference is
# per-machine. The S6C keys that DO belong to the fleet live in
# install_programs/dms-settings.s6c.json and are merged in by the installer,
# which never overwrites a value already set. .gitkeep keeps this directory in
# git so stow still folds it into a single symlink -- without it a fresh clone
# has no directory here, DMS creates a real one, and s10_dotfiles rm -rf's it.
.config/DankMaterialShell/settings.json
.config/DankMaterialShell/firefox.css
.config/DankMaterialShell/zen.css
.config/DankMaterialShell/.firstlaunch
.config/DankMaterialShell/.changelog-*

# Hyprland: the same split as niri above, in Lua. DMS rewrites colors.lua on
# every theme change, outputs.lua from its Displays page, cursor.lua from its
# Cursor page, and layout.lua and windowrules.lua every time it starts (seen
# 28 Sep 2026: it stamps them "managed by DankMaterialShell"); s6c-machine.lua
# is written by the installer for this machine's GPU; .dms-backups is where DMS
# sweeps stray files. The installer writes stubs for all of these so hyprland.lua's
# require() never fails. hyprland.lua, binds.lua and binds-user.lua are the
# fleet's and are tracked.
.config/hypr/dms/colors.lua
.config/hypr/dms/outputs.lua
.config/hypr/dms/cursor.lua
.config/hypr/dms/layout.lua
.config/hypr/dms/windowrules.lua
.config/hypr/dms/s6c-machine.lua
.config/hypr/.dms-backups/
.config/hypr/hyprland.conf
.config/hypr/*.bak

# dank-theme.toml is a matugen template output -- DMS lists it under
# tags ["matugen","alacritty","terminal","template"] and rewrites it whenever a
# theme is applied. It arrived tracked in e6a9664, and once ~/.config/alacritty
# became a directory symlink (2 Sep 2026, this machine) every theme change would
# have shown up as a spurious diff -- the same trap cursor.kdl hit above.
# alacritty.toml stays tracked; it imports this file by path, so the import
# keeps working with the file untracked.
.config/alacritty/dank-theme.toml
