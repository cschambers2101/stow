// @id=wr_1788084513678219657 @name=BambuStudio
window-rule {
    match app-id="^BambuStudio$" is-floating=false
    open-maximized true
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}
